#!/bin/sh

# vpn
# this script uses rofi as a ui for interfacing with wireguard vpn configs
# it uses proton specific logic to parse comments when adding new configs
# this part would need to be changed to make it work with cconfigs from other vpn providers

# list all wireguard configs
get_configs() {
    ls /etc/wireguard/*.conf 2>/dev/null | xargs -n1 basename -s .conf
}

# get the active wireguard config
get_active_config() {
    sudo wg show interfaces 2>/dev/null
}

# is wireguard connected
is_connected() {
    [ -n "$(get_active_config)" ]
}

if is_connected; then
    ACTIVE=$(get_active_config)
    # if connected, display the Disconnect option
    CHOICE=$(printf "Disconnect\nAdd config\nDelete config" | rofi -dmenu -p "VPN (Connected: $ACTIVE)")
else
    # if not connected, display the Connect option
    CHOICE=$(printf "Connect\nAdd config\nDelete config" | rofi -dmenu -p "VPN (Disconnected)")
fi

# handle rofi menu options
case "$CHOICE" in
    "Connect")
        CONFIGS=$(get_configs)
        if [ -z "$CONFIGS" ]; then
            notify-send "VPN" "No configs available. Add one first."
            exit 0
        fi
        
        # prompt the user with available configs
        SELECTED=$(echo "$CONFIGS" | rofi -dmenu -p "Connect to which config?")
        [ -z "$SELECTED" ] && exit 0
        
        # connect to the selected config
        if sudo wg-quick up "$SELECTED"; then
            notify-send "VPN" "Connected to $SELECTED"
        else
            notify-send "VPN" "Failed to connect"
            exit 1
        fi
        ;;
    "Disconnect")
        # disconnect from the active connection
        ACTIVE=$(get_active_config)
        if sudo wg-quick down "$ACTIVE"; then
            notify-send "VPN" "Disconnected from $ACTIVE"
        else
            notify-send "VPN" "Failed to disconnect"
            exit 1
        fi
        ;;
    "Add config")
        # launch rofi in file browser mode for file search capabilities
        SELECTED_FILE=$(rofi -show filebrowser -filebrowser-command "echo" 2>/dev/null)
        
        if [ -z "$SELECTED_FILE" ]; then
            exit 0
        fi
        
        if [ ! -f "$SELECTED_FILE" ]; then
            notify-send "VPN" "Error: Not a valid file"
            exit 1
        fi
        
        CONFIG_NAME=$(basename "$SELECTED_FILE")
        TARGET="/etc/wireguard/$CONFIG_NAME"
        
        # prevent creation if the config already exists
        if test -f "$TARGET"; then
            notify-send "VPN" "Error: Config already exists: $CONFIG_NAME"
            exit 1
        fi
        
        # sh -c is needed to run cp and chmod with a single pkexec password entry
        # and add MTU = 1380 to the config, if it doesn't already exist
        # MTU is a network specific setting, and this value works for me
        # it could need changing on different networks
        if pkexec sh -c "cp '$SELECTED_FILE' '$TARGET' && chmod 600 '$TARGET' && \
            if ! grep -q '^MTU' '$TARGET'; then \
                sed -i '/^\[Interface\]/a MTU = 1380' '$TARGET'; \
            fi"; then
            notify-send "VPN" "Added config: $CONFIG_NAME (with MTU fix)"
        else
            notify-send "VPN" "Failed to add config"
            exit 1
        fi
        ;;
    "Delete config")
        ACTIVE=$(get_active_config)
        CONFIGS=$(get_configs)
        
        if [ -z "$CONFIGS" ]; then
            notify-send "VPN" "No configs available"
            exit 0
        fi
        
        # prompt the user with available configs
        SELECTED=$(echo "$CONFIGS" | rofi -dmenu -p "Delete which config?")
        [ -z "$SELECTED" ] && exit 0
        
        # prevent deletion of the active config
        if [ -n "$ACTIVE" ] && [ "$SELECTED" = "$ACTIVE" ]; then
            notify-send "VPN" "Cannot delete active config: $SELECTED"
            exit 1
        fi
        
        # prompt for confirmation of deletion, then delete
        CONFIRM=$(printf "No\nYes" | rofi -dmenu -p "Delete $SELECTED?")
        if [ "$CONFIRM" = "Yes" ]; then
            if pkexec rm "/etc/wireguard/$SELECTED.conf"; then
                notify-send "VPN" "Deleted config: $SELECTED"
            else
                notify-send "VPN" "Failed to delete config"
                exit 1
            fi
        fi
        ;;
esac
